<section class="home">
    <div class="filter">
        <ul>
            <li class="active">All</li>
            <li>Live</li>
            <li>Gaming</li>
            <li>Films</li>
            <li>Music</li>
            <li>Design</li>
        </ul>
    </div>
    <div class="videos">
        {{#each data}}
        <div class="video_item">
            <video src="/{{this.path}}" controls></video>
            <div class="info-card">
                <div class="avatar">
                    <h1>{{this.author_name.[0]}}</h1>
                </div>
                <div class="text">
                    <strong>{{this.title}}</strong>
                    <p>{{this.author_name}} • {{this.formatted_date}}</p>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</section>