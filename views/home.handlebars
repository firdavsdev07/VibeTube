<section class="home">
    <div class="filter">
        <ul>
            <li class="active">All</li>
            <li>Live</li>
            <li>Gaming</li>
            <li>Films</li>
            <li>Music</li>
            <li>Design</li>
        </ul>
    </div>
    <div class="videos">
        {{#each data}}
        <div class="video_item">
            <video src="/{{this.path}}" controls></video>
            <div class="info-card">
                <div class="avatar">
                    <h1>{{this.author_name.[0]}}</h1>
                </div>
                <div class="text">
                    <strong>{{this.title}}</strong>
                    <p>{{this.author_name}} • {{this.formatted_date}}</p>
                </div>
            </div>
            {{#if (eq this.author ../userId)}}
            <div class="video-actions">
                <a href="/edit/{{this.id}}?username={{../username}}&userId={{../userId}}" class="edit-btn">
                    <i class="fa-solid fa-pen"></i> Edit
                </a>
                <form action="/delete/{{this.id}}?username={{../username}}&userId={{../userId}}" method="POST" onsubmit="return confirm('Videoni o\'chirmoqchimisiz?')">
                    <button type="submit" class="delete-btn">
                        <i class="fa-solid fa-trash"></i> Delete
                    </button>
                </form>
            </div>
            {{/if}}
        </div>
        {{/each}}
    </div>
</section>