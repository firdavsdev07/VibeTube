<section class="upload-box">

    <div class="header">
        <h1>Manage Videos</h1>
        <p>Upload new content and manage your existing video library</p>
    </div>

    <div class="upload-form">

        <h2 class="form-title">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            Upload New Video
        </h2>

        <form>

            <div class="form-left">
                <label for="title">Video Title</label>
                <input type="text" id="title" placeholder="e.g. My Awesome Vlog #1">

                <label for="desc">Description (Optional)</label>
                <textarea id="desc" placeholder="Tell viewers about your video"></textarea>
            </div>

            <div class="video-file">

                <input type="file" id="fileInput" hidden>

                <i class="fa-solid fa-file-arrow-up upload-icon"></i>
                <p>Drag and drop video files to upload</p>
                <span>MP4, MOV up to 2GB</span>

                <label for="fileInput" class="upload-btn">Select Files</label>

            </div>

            <button class="publish-btn">
                <i class="fa-solid fa-rocket"></i>
                Publish Video
            </button>

        </form>

    </div>

</section>